<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeepSeek.Agui.Agent</RootNamespace>
    <UsePublishedDeepSeekPackages Condition="'$(UsePublishedDeepSeekPackages)' == ''">false</UsePublishedDeepSeekPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore"  />
    <PackageReference Include="Microsoft.Extensions.AI" />
	<PackageReference Include="Serilog.Extensions.Logging"  />
	<PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedDeepSeekPackages)' == 'true'">
    <PackageReference Include="DeepSeek.Core" />
    <PackageReference Include="DeepSeek.Agents.AI" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedDeepSeekPackages)' != 'true'">
    <ProjectReference Include="..\..\src\DeepSeek.Agents.AI\DeepSeek.Agents.AI.csproj" />
    <ProjectReference Include="..\..\src\DeepSeek.Core\DeepSeek.Core.csproj" />
  </ItemGroup>

</Project>
