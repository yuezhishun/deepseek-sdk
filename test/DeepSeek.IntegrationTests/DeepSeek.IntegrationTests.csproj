<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(CompatibilityTargetFramework)' == ''">net10.0</TargetFramework>
    <TargetFramework Condition="'$(CompatibilityTargetFramework)' != ''">$(CompatibilityTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <UserSecretsId>db67dc3b-2a19-4c2e-bb82-94114f2e48c7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DeepSeekTestModels.cs" Link="DeepSeekTestModels.cs" />
    <Compile Include="..\TestApiKeyProvider.cs" Link="TestApiKeyProvider.cs" />
    <Content Include="..\..\sample\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\sample\appsettings.json')" />
    <Content Include="..\..\sample\appsettings.dev.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('..\..\sample\appsettings.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeepSeek.Core\DeepSeek.Core.csproj" />
    <ProjectReference Include="..\..\src\DeepSeek.Agents.AI\DeepSeek.Agents.AI.csproj" />
  </ItemGroup>

  <Target Name="RemoveStaleLocalAppSettings" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory" Condition="!Exists('..\..\sample\appsettings.json')">
    <Delete Files="$(TargetDir)appsettings.json" />
  </Target>
</Project>
