<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Authors>Yue Zhishun</Authors>
    <Company>Yue Zhishun</Company>
    <Description>Agent Framework and Microsoft.Extensions.AI adapter for the DeepSeek typed client.</Description>
    <PackageReleaseNotes>1.0.5：补齐三协议推理、工具图片、Anthropic 流式工具参数及服务端搜索历史；统一缓存、搜索、抓取用量。新增 Responses 适配器及强类型多模态兼容性变化。验证 .NET 11 RC3。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/yuezhishun/deepseek-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yuezhishun/deepseek-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>LLM,AI,DeepSeek,Microsoft.Extensions.AI,Microsoft.Agents.AI,.NETStandard</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <PackageIcon>logo.png</PackageIcon>
    <Version>1.0.5</Version>
    <PackageId>DeepSeek.Agents.AI</PackageId>
    <AssemblyName>DeepSeek.Agents.AI</AssemblyName>
    <RootNamespace>DeepSeek.Agents.AI</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <OutputType>Library</OutputType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>1701;1702;1591;1570</NoWarn>
    <Title>DeepSeek.Agents.AI</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SignAssembly>false</SignAssembly>
    <PackageOutputPath>./pack</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeepSeek.Core\DeepSeek.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\logo.png" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
